{
  "name": "@fenwei/pi-provider-needle",
  "version": "0.1.0",
  "description": "pi-ai provider and pi extension for local Needle 2 inference",
  "type": "module",
  "license": "MIT",
  "homepage": "https://needle.fenwei.dev/integrations/pi-ai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fenwei-dev/needle.js.git",
    "directory": "packages/pi-provider-needle"
  },
  "bugs": {
    "url": "https://github.com/fenwei-dev/needle.js/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js",
      "default": "./dist/extension.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "bun run build",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fenwei/needle.js": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/bun": "1.4.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-package",
    "pi-ai",
    "needle-2",
    "tool-calling",
    "local-ai"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  }
}
