{
  "name": "@fenwei/needle-ai-provider",
  "version": "0.1.1",
  "description": "Vercel AI SDK provider for local Needle 2 inference",
  "type": "module",
  "license": "MIT",
  "homepage": "https://needle.js.org/integrations/ai-sdk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fenwei-dev/needle.js.git",
    "directory": "packages/needle-ai-provider"
  },
  "bugs": {
    "url": "https://github.com/fenwei-dev/needle.js/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "bun run build",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.9"
  },
  "peerDependencies": {
    "@fenwei/needle.js": ">=0.1.0"
  },
  "devDependencies": {
    "@fenwei/needle.js": "workspace:*",
    "@types/bun": "1.4.3",
    "ai": "^7.0.85",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-sdk",
    "vercel-ai-sdk",
    "needle-2",
    "tool-calling",
    "local-ai"
  ]
}
